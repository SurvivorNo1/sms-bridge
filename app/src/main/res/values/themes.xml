<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="primary">#1E88E5</color>
    <color name="primary_dark">#1565C0</color>
    <color name="bg">#F4F6FA</color>
    <color name="card">#FFFFFF</color>
    <color name="text">#1B1F24</color>
    <color name="text2">#6B7280</color>
    <color name="ok">#2E7D32</color>
    <color name="off">#9CA3AF</color>
    <color name="warn">#B45309</color>
    <color name="mono_bg">#F1F3F7</color>

    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text2</item>
    </style>

    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">18dp</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:elevation">1dp</item>
    </style>

    <style name="CardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text2</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="Mono">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:typeface">monospace</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:background">@drawable/bg_mono</item>
        <item name="android:padding">10dp</item>
        <item name="android:textIsSelectable">true</item>
    </style>

    <style name="TextBtn" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">40dp</item>
    </style>
</resources>
